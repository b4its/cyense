# Cyense — environment configuration (contoh).
# SALIN file ini menjadi `.env` dan isi dengan nilai Anda sendiri.
# JANGAN pernah commit `.env` asli — file ini hanya templat.
#
#   cp .env.example .env
#
# Semua variabel dibaca dengan prefix CYENSE_ oleh app/core/config.py
# (pydantic-settings), jadi CYENSE_LOG_LEVEL → log_level.

# ── Service ────────────────────────────────────────────────────────────────
# Level log service: DEBUG | INFO | WARNING | ERROR | CRITICAL
CYENSE_LOG_LEVEL=INFO

# ── Probing behaviour ──────────────────────────────────────────────────────
CYENSE_MAX_CONCURRENCY=10
CYENSE_RATE_LIMIT=50
CYENSE_REQUEST_TIMEOUT=10.0

# ── Verification ───────────────────────────────────────────────────────────
CYENSE_SIMILARITY_THRESHOLD=0.80
CYENSE_VERIFY_RETRIES=2
CYENSE_CONTROL_ID=99999999
CYENSE_PROBE_MAX=50

# ── Filesystem ─────────────────────────────────────────────────────────────
CYENSE_REPORTS_DIR=reports
CYENSE_BRAIN_DIR=brain
CYENSE_WORKSPACE_DIR=/workspace

# ── GitHub scan ────────────────────────────────────────────────────────────
CYENSE_GITHUB_MAX_MB=50
CYENSE_GITHUB_MAX_FILES=3000
CYENSE_GITHUB_TIMEOUT=60.0
CYENSE_GITHUB_CACHE=true

# Token GitHub (OPSTIONAL — hanya untuk rate limit API yang lebih tinggi).
# TIDAK PERNAH menaruh token asli di sini; isi di .env lokal Anda.
# Dapat juga diatur via: cyense config set github_token <token>
# CYENSE_GITHUB_TOKEN=ghp_xxxxxxxxxxxx

# API URL (untuk CLI client — default http://localhost:8000)
# CYENSE_API_URL=http://localhost:8000

# ── CI / Compliance reporting ──────────────────────────────────────────────
CYENSE_SCAN_MODE_DEFAULT=standard
CYENSE_SCOPE_MODE_DEFAULT=auto
CYENSE_SARIF_ENABLED=true
CYENSE_COVERAGE_ENABLED=true

# ── Live CVE search (NVD / MITRE) ─────────────────────────────────────────
CYENSE_CVE_ONLINE_ENABLED=true
CYENSE_CVE_SEARCH_TIMEOUT=12.0

# ── Discovery stage (HackerOne-tools adaptation) ───────────────────────────
CYENSE_DISCOVERY_ENABLED=true
