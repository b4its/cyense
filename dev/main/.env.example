# Cyense service configuration (PRD v2.0, section 5.4)
# Copy to .env or export as environment variables (prefix CYENSE_).

CYENSE_LOG_LEVEL=INFO
CYENSE_MAX_CONCURRENCY=10
CYENSE_RATE_LIMIT=50
CYENSE_REQUEST_TIMEOUT=10
CYENSE_SIMILARITY_THRESHOLD=0.85
CYENSE_VERIFY_RETRIES=2
CYENSE_CONTROL_ID=99999999
CYENSE_PROBE_MAX=50
CYENSE_REPORTS_DIR=/app/reports
CYENSE_BRAIN_DIR=/app/brain
CYENSE_WORKSPACE_DIR=/workspace
